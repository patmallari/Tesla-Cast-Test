# Copy this file to .env and adjust for your deployment.

# Port the Node server listens on.
PORT=3000

# Public HTTPS URL this app is served at (used to build the QR code / sender link).
# In production this MUST be your real https:// domain — WebRTC requires a secure
# context, and getDisplayMedia() will refuse to run over plain http:// on anything
# other than localhost.
PUBLIC_URL=https://your-domain.example.com

# STUN server used for NAT traversal (default: Google's public STUN server).
STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN server, only needed if peer-to-peer WebRTC fails behind strict
# NATs/firewalls (common on some cellular networks and in-car modems). Leave
# blank to skip TURN entirely.
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=
